                                            <span class="label">Endereço</span>
                                            <strong><?= htmlspecialchars($local['endereco'] ?? 'Não informado') ?></strong>
                                        </div>

                                        <?php if (!empty($local['cnpj'])): ?>
                                            <div class="local-meta">
                                                <span class="label">CNPJ</span>
                                                <strong><?= htmlspecialchars(preg_replace('/(\d{2})(\d{3})(\d{3})(\d{4})(\d{2})/', '$1.$2.$3/$4-$5', (string) $local['cnpj'])) ?></strong>
                                            </div>
                                        <?php endif; ?>
                                    </div>

                                    <div class="local-card-actions">
