                        </div>

                        <div class="local-form-section">
                            <h6 class="local-form-section-title">Geolocalização</h6>
                            <div class="row g-3">
                                <div class="col-md-12">
                                    <label for="endereco_busca" class="form-label">Buscar endereço no mapa</label>
                                    <div class="local-map-search-wrap">
                                        <input type="text" class="form-control" id="endereco_busca" name="endereco_busca" placeholder="Ex.: Avenida Paulista, São Paulo - SP">
                                        <button type="button" class="btn btn-outline-primary local-map-search-btn" id="btnBuscarEndereco">Buscar</button>
                                    </div>
                                    <div id="mapaMensagemCadastro" class="local-map-message" aria-live="polite"></div>
                                </div>
                                <div class="col-md-12">
                                    <div id="mapaLocalCadastro" class="local-map-container" aria-label="Mapa para localização do estabelecimento"></div>
                                </div>
                                <div class="col-md-6">
                                    <label for="latitude" class="form-label">Latitude</label>
                                    <input type="text" class="form-control" id="latitude" name="latitude" readonly>
                                </div>
                                <div class="col-md-6">
                                    <label for="longitude" class="form-label">Longitude</label>
