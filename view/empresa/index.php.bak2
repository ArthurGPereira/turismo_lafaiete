    <script src="https://unpkg.com/leaflet@1.9.4/dist/leaflet.js" integrity="sha256-4Z8e+gG+2z8V8V8z8V8z8V8z8V8z8V8z8V8z8V8=" crossorigin=""></script>
    <script src="../../assets/js/empresa-local-mapa.js?v=3"></script>

    <script>
        document.addEventListener('DOMContentLoaded', function () {
            const modalCadastrar = document.getElementById('cadastrarLocalModal');
            const modalEditar = document.getElementById('editarLocalModal');
            const modalExcluir = document.getElementById('confirmarExclusaoLocalModal');

            if (modalExcluir) {
                modalExcluir.addEventListener('show.bs.modal', function (event) {
                    const trigger = event.relatedTarget;
                    const idLocal = trigger ? trigger.getAttribute('data-local-id') : '0';
                    const nomeLocal = trigger ? trigger.getAttribute('data-local-nome') : 'este estabelecimento';
                    const inputId = document.getElementById('idLocalExclusao');
                    const nomeExclusao = document.getElementById('nomeLocalExclusao');

                    if (inputId) {
                        inputId.value = idLocal || '0';
                    }

                    if (nomeExclusao) {
                        nomeExclusao.textContent = nomeLocal || 'este estabelecimento';
                    }
                });
            }

            const maskCnpj = (input) => {
                if (!input) {
                    return;
                }

                input.addEventListener('input', function () {
                    let value = input.value.replace(/\D/g, '').slice(0, 14);

                    if (value.length > 12) {
                        value = value.replace(/(\d{2})(\d{3})(\d{3})(\d{4})(\d{2})/, '$1.$2.$3/$4-$5');
                    } else if (value.length > 8) {
                        value = value.replace(/(\d{2})(\d{3})(\d{3})(\d{4})/, '$1.$2.$3/$4');
                    } else if (value.length > 5) {
                        value = value.replace(/(\d{2})(\d{3})(\d{3})/, '$1.$2.$3');
                    } else if (value.length > 2) {
                        value = value.replace(/(\d{2})(\d{3})/, '$1.$2');
                    }

                    input.value = value;
                });
            };

            const cnpjInput = document.getElementById('cnpj');
            maskCnpj(cnpjInput);

            const editarCnpjInput = document.getElementById('editar_cnpj');
            maskCnpj(editarCnpjInput);

            const formCadastrar = modalCadastrar ? modalCadastrar.querySelector('form') : null;
            if (formCadastrar && cnpjInput) {
                formCadastrar.addEventListener('submit', function () {
                    const cnpjValue = cnpjInput.value.replace(/\D/g, '');
                    if (cnpjValue !== '') {
                        cnpjInput.value = cnpjValue;
                    }
                });
            }

            const formEditar = modalEditar ? modalEditar.querySelector('form') : null;
            if (formEditar && editarCnpjInput) {
                formEditar.addEventListener('submit', function () {
                    const cnpjValue = editarCnpjInput.value.replace(/\D/g, '');
                    if (cnpjValue !== '') {
                        editarCnpjInput.value = cnpjValue;
                    }
                });
            }

            if (modalCadastrar) {
                modalCadastrar.addEventListener('hidden.bs.modal', function () {
                    modalCadastrar.querySelector('form').reset();
                });
            }

            if (modalEditar) {
                modalEditar.addEventListener('hidden.bs.modal', function () {
                    modalEditar.querySelector('form').reset();
                });
            }
        });
    </script>

</body>

</html>
