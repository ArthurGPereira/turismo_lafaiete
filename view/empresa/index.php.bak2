                                        </a>
                                        <button type="button" class="btn btn-sm btn-danger" data-bs-toggle="modal" data-bs-target="#confirmarExclusaoLocalModal" data-local-id="<?= htmlspecialchars((string) ($local['id_local'] ?? 0)) ?>" data-local-nome="<?= htmlspecialchars($local['nome'] ?? 'este estabelecimento') ?>">
