<?php

session_start();

if (!isset($_SESSION['id_usuario'])) {
    $_SESSION['login_erro'] = 'Faça login para acessar o painel da empresa.';
    header('Location: ../login.php');
    exit;
}

if (($_SESSION['tipo_usuario'] ?? '') !== 'empresa') {
    $_SESSION['login_erro'] = 'Acesso restrito para empresas.';
    header('Location: ../login.php');
    exit;
}

require_once __DIR__ . '/../../dao/EmpresaDAO.php';
require_once __DIR__ . '/../../controller/UsuarioController.php';
require_once __DIR__ . '/../../controller/LocalController.php';
require_once __DIR__ . '/../../controller/CategoriaController.php';
require_once __DIR__ . '/../../controller/CidadeController.php';

$bootstrapCssFile = __DIR__ . '/../../assets/css/bootstrap.min.css';
$bootstrapJsFile = __DIR__ . '/../../assets/js/bootstrap.bundle.min.js';
$bootstrapCssUrl = file_exists($bootstrapCssFile)
    ? '../../assets/css/bootstrap.min.css'
    : 'https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css';
$bootstrapJsUrl = file_exists($bootstrapJsFile)
    ? '../../assets/js/bootstrap.bundle.min.js'
    : 'https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js';

$idUsuario = (int) $_SESSION['id_usuario'];

$empresaDAO = new EmpresaDAO();
$empresa = $empresaDAO->buscarPorIdUsuario($idUsuario);

if (!$empresa) {
    $_SESSION['login_erro'] = 'Empresa não cadastrada ou não autorizada.';
    header('Location: ../login.php');
    exit;
}

$status = strtolower((string) ($empresa['status'] ?? ''));

if ($status !== 'ativa') {
    $_SESSION['login_erro'] = $status === 'pendente'
        ? 'Sua empresa ainda está aguardando aprovação.'
        : ($status === 'suspensa'
            ? 'O acesso da sua empresa está suspenso.'
            : ($status === 'recusada'
                ? 'O cadastro da sua empresa foi recusado.'
                : 'Seu acesso não está habilitado.'));

    header('Location: ../login.php');
    exit;
}

$usuarioController = new UsuarioController();
$usuario = $usuarioController->buscarPorId($idUsuario);

if (!$usuario) {
    $_SESSION['login_erro'] = 'Usuário não encontrado.';
    header('Location: ../login.php');
    exit;
}

$nomeUsuario = $usuario['nome'] ?? 'Empresa';
$nomeEmpresa = $empresa['nome_fantasia'] ?? $empresa['razao_social'] ?? 'Empresa';
$cnpj = $empresa['cnpj'] ?? '';
$cnpjFormatado = $cnpj !== '' ? preg_replace('/(\d{2})(\d{3})(\d{3})(\d{4})(\d{2})/', '$1.$2.$3/$4-$5', $cnpj) : 'Não informado';
$emailContato = $empresa['email_contato'] ?? 'Não informado';
$telefone = $empresa['telefone'] ?? 'Não informado';
$statusLabel = ucfirst($status);

$idEmpresa = (int) ($empresa['id_empresa'] ?? 0);
if ($idEmpresa <= 0) {
    $_SESSION['login_erro'] = 'Empresa não cadastrada ou não autorizada.';
    header('Location: ../login.php');
    exit;
}

$localController = new LocalController();
$categoriaController = new CategoriaController();
$cidadeController = new CidadeController();

if (empty($_SESSION['csrf_token_local_empresa'])) {
    $_SESSION['csrf_token_local_empresa'] = bin2hex(random_bytes(32));
}

$categorias = $categoriaController->listar();
$cidades = $cidadeController->listar();

$mensagemLocal = '';
$tipoMensagemLocal = 'info';
$localEdicao = null;

if (isset($_POST['excluir_local_empresa'])) {
    if (!isset($_POST['csrf']) || !hash_equals($_SESSION['csrf_token_local_empresa'], (string) $_POST['csrf'])) {
        $mensagemLocal = 'Sessão inválida. Tente novamente.';
        $tipoMensagemLocal = 'erro';
    } else {
        $idLocal = (int) ($_POST['id_local'] ?? 0);
        $localAtual = $localController->buscarPorIdEmpresa($idLocal, $idEmpresa);

        if (!$localAtual) {
            $mensagemLocal = 'Local não encontrado ou não pertence à sua empresa.';
            $tipoMensagemLocal = 'erro';
        } else {
            $resultado = $localController->excluirPorEmpresa($idLocal, $idEmpresa);

            if ($resultado) {
                $mensagemLocal = 'Local excluído com sucesso.';
                $tipoMensagemLocal = 'sucesso';
            } else {
                $mensagemLocal = 'Não foi possível excluir este local.';
                $tipoMensagemLocal = 'erro';
            }
        }
    }
} elseif (isset($_POST['cadastrar_local_empresa'])) {
    $dados = [
        'id_empresa' => $idEmpresa,
        'id_cidade' => (int) ($_POST['id_cidade'] ?? 0),
        'id_categoria' => (int) ($_POST['id_categoria'] ?? 0),
        'nome' => trim((string) ($_POST['nome'] ?? '')),
        'descricao' => trim((string) ($_POST['descricao'] ?? '')),
        'endereco' => trim((string) ($_POST['endereco'] ?? '')),
        'telefone' => trim((string) ($_POST['telefone'] ?? '')),
        'email' => trim((string) ($_POST['email'] ?? '')),
        'horario_funcionamento' => trim((string) ($_POST['horario_funcionamento'] ?? '')),
        'preco' => $_POST['preco'] !== '' ? trim((string) $_POST['preco']) : null,
        'latitude' => $_POST['latitude'] !== '' ? trim((string) $_POST['latitude']) : null,
        'longitude' => $_POST['longitude'] !== '' ? trim((string) $_POST['longitude']) : null,
        'status' => 'ativo',
    ];

    if ($dados['id_cidade'] <= 0 || $dados['id_categoria'] <= 0 || $dados['nome'] === '' || $dados['endereco'] === '') {
        $mensagemLocal = 'Preencha cidade, categoria, nome e endereço do local.';
        $tipoMensagemLocal = 'erro';
    } else {
        $idLocalNovo = $localController->cadastrarParaEmpresa($dados, $idEmpresa);

        if ($idLocalNovo) {
            $mensagemLocal = 'Local cadastrado com sucesso.';
            $tipoMensagemLocal = 'sucesso';
        } else {
            $mensagemLocal = 'Não foi possível cadastrar este local.';
            $tipoMensagemLocal = 'erro';
        }
    }
} elseif (isset($_POST['salvar_local_empresa'])) {
    $idLocal = (int) ($_POST['id_local'] ?? 0);
    $localAtual = $localController->buscarPorIdEmpresa($idLocal, $idEmpresa);

    if (!$localAtual) {
        $mensagemLocal = 'Local não encontrado ou não pertence à sua empresa.';
        $tipoMensagemLocal = 'erro';
    } else {
        $dados = [
            'id_local' => $idLocal,
            'id_empresa' => $idEmpresa,
            'id_cidade' => (int) ($_POST['id_cidade'] ?? 0),
            'id_categoria' => (int) ($_POST['id_categoria'] ?? 0),
            'nome' => trim((string) ($_POST['nome'] ?? '')),
            'descricao' => trim((string) ($_POST['descricao'] ?? '')),
            'endereco' => trim((string) ($_POST['endereco'] ?? '')),
            'telefone' => trim((string) ($_POST['telefone'] ?? '')),
            'email' => trim((string) ($_POST['email'] ?? '')),
            'horario_funcionamento' => trim((string) ($_POST['horario_funcionamento'] ?? '')),
            'preco' => $_POST['preco'] !== '' ? trim((string) $_POST['preco']) : null,
            'latitude' => $_POST['latitude'] !== '' ? trim((string) $_POST['latitude']) : null,
            'longitude' => $_POST['longitude'] !== '' ? trim((string) $_POST['longitude']) : null,
            'cnpj' => isset($_POST['cnpj']) ? trim((string) $_POST['cnpj']) : ($localAtual['cnpj'] ?? null),
            'status' => $localAtual['status'] ?? 'ativo',
        ];

        if ($dados['id_cidade'] <= 0 || $dados['id_categoria'] <= 0 || $dados['nome'] === '' || $dados['endereco'] === '') {
            $mensagemLocal = 'Preencha cidade, categoria, nome e endereço do local.';
            $tipoMensagemLocal = 'erro';
        } else {
            $resultado = $localController->editarPorEmpresa($dados, $idEmpresa);

            if ($resultado) {
                $mensagemLocal = 'Local atualizado com sucesso.';
                $tipoMensagemLocal = 'sucesso';
            } else {
                $mensagemLocal = 'Não foi possível atualizar este local.';
                $tipoMensagemLocal = 'erro';
            }
        }
    }
} elseif (isset($_GET['excluir_local_id'])) {
    $idLocal = (int) ($_GET['excluir_local_id'] ?? 0);
    $localAtual = $localController->buscarPorIdEmpresa($idLocal, $idEmpresa);

    if (!$localAtual) {
        $mensagemLocal = 'Local não encontrado ou não pertence à sua empresa.';
        $tipoMensagemLocal = 'erro';
    } else {
        $resultado = $localController->excluirPorEmpresa($idLocal, $idEmpresa);

        if ($resultado) {
            $mensagemLocal = 'Local excluído com sucesso.';
            $tipoMensagemLocal = 'sucesso';
        } else {
            $mensagemLocal = 'Não foi possível excluir este local.';
            $tipoMensagemLocal = 'erro';
        }
    }
}

if (isset($_GET['editar_local_id'])) {
    $idLocalEdicao = (int) ($_GET['editar_local_id'] ?? 0);
    $localEdicao = $localController->buscarPorIdEmpresa($idLocalEdicao, $idEmpresa);

    if (!$localEdicao) {
        $localEdicao = null;
        $mensagemLocal = 'Local não encontrado ou não pertence à sua empresa.';
        $tipoMensagemLocal = 'erro';
    }
}

$locaisEmpresa = $localController->listarPorEmpresa($idEmpresa);
?>

