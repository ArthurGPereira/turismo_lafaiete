                    <?php if ($mensagemLocal !== ''): ?>
                        <div class="alert alert-<?= htmlspecialchars($tipoMensagemLocal) ?>" role="alert">
                            <?= htmlspecialchars($mensagemLocal) ?>
                        </div>
                    <?php endif; ?>

                    <div class="d-flex justify-content-between align-items-center gap-3 flex-wrap mb-3">
                        <div class="muted">Estabelecimentos vinculados à sua empresa</div>
                        <button class="btn btn-success" data-bs-toggle="modal" data-bs-target="#cadastrarLocalModal">
                            <i class="fa-solid fa-plus"></i> Cadastrar novo local
                        </button>
                    </div>

                    <?php if (count($locaisEmpresa) === 0): ?>
                        <div class="local-empty-state">
                            <i class="fa-solid fa-location-dot"></i>
                            <h4>Nenhum estabelecimento cadastrado</h4>
                            <p>Você ainda não possui locais vinculados à sua empresa. Use o botão acima para cadastrar o primeiro estabelecimento.</p>
                        </div>
                    <?php else: ?>
                        <div class="local-list">
                            <?php foreach ($locaisEmpresa as $local): ?>
                                <article class="local-card">
                                    <div class="local-card-header">
                                        <div class="local-card-title-wrap">
