/* =========================================================
   PAINEL EMPRESA - ESTILOS ESPECÍFICOS
   ========================================================= */

.dashboard-body {
    padding: 28px 38px 0;
}

.welcome-panel {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 16px;
    padding: 24px 28px;
    border: 1px solid #e2e8ee;
    border-left: 4px solid #e4a51b;
    border-radius: 14px;
    background: linear-gradient(135deg, #ffffff 0%, #edf5f7 100%);
    box-shadow: 0 12px 30px rgba(20, 52, 60, 0.04);
}

.welcome-panel h2 {
    margin: 0 0 8px;
    color: #183f4d;
    font-size: 1.7rem;
}

.welcome-panel p {
    margin: 0;
    color: #5d7380;
    font-size: 0.98rem;
}

.welcome-badge {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    min-width: 120px;
    padding: 9px 14px;
    border-radius: 999px;
    background: rgba(24, 115, 149, 0.12);
    color: #0d5a70;
    font-weight: 700;
    font-size: 0.82rem;
    letter-spacing: 0.04em;
    text-transform: uppercase;
}

.summary-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(220px, 1fr));
    gap: 20px;
    margin-top: 28px;
    padding: 0 38px;
}

.summary-card {
    background: #ffffff;
    border: 1px solid #e5eaef;
    border-radius: 14px;
    padding: 20px 18px 18px;
    box-shadow: 0 10px 22px rgba(15, 45, 56, 0.04);
}

.summary-card .label {
    display: block;
    margin-bottom: 10px;
    color: #7a8f97;
    font-size: 0.75rem;
    font-weight: 700;
    letter-spacing: 0.08em;
    text-transform: uppercase;
}

.summary-card .value {
    color: #183f4d;
    font-size: 1.15rem;
    font-weight: 700;
    line-height: 1.4;
    word-break: break-word;
}

.section-grid {
    display: grid;
    grid-template-columns: 1.2fr 1fr;
    gap: 22px;
    padding: 28px 38px 32px;
}

.panel-box {
    background: #ffffff;
    border: 1px solid #e5eaef;
    border-radius: 14px;
    padding: 22px 20px;
    box-shadow: 0 10px 22px rgba(15, 45, 56, 0.04);
}

.panel-box h3 {
    margin: 0 0 18px;
    color: #183f4d;
    font-size: 1.2rem;
}

.future-list {
    list-style: none;
    display: grid;
    gap: 12px;
    padding: 0;
    margin: 0;
}

.future-list li {
    display: flex;
    align-items: center;
    gap: 10px;
    padding: 12px 14px;
    border-radius: 10px;
    background: #f7fafb;
    color: #375765;
    border: 1px solid #ebf0f2;
}

.future-list i {
    color: #e4a51b;
}

.muted {
    color: #617883;
    font-size: 0.9rem;
}

.local-list {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(260px, 1fr));
    gap: 18px;
    margin-top: 18px;
}

.local-card {
    display: flex;
    flex-direction: column;
    gap: 16px;
    padding: 20px 18px;
    border: 1px solid #e2e8ee;
    border-left: 4px solid #e4a51b;
    border-radius: 14px;
    background: linear-gradient(180deg, #ffffff 0%, #f7fafb 100%);
    box-shadow: 0 10px 22px rgba(15, 45, 56, 0.04);
}

.local-card-header {
    display: flex;
    align-items: flex-start;
    justify-content: space-between;
    gap: 12px;
}

.local-card-title-wrap {
    display: flex;
    flex-direction: column;
    gap: 6px;
    min-width: 0;
}

.local-badge {
    display: inline-flex;
    align-items: center;
    width: fit-content;
    padding: 5px 8px;
    border-radius: 999px;
    background: rgba(228, 165, 27, 0.12);
    color: #a06e00;
    font-size: 0.68rem;
    font-weight: 700;
    letter-spacing: 0.06em;
    text-transform: uppercase;
}

.local-card h4 {
    margin: 0;
    color: #183f4d;
    font-size: 1.1rem;
    line-height: 1.4;
    word-break: break-word;
}

.local-status {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    min-width: 86px;
    padding: 7px 10px;
    border-radius: 999px;
    background: rgba(24, 115, 149, 0.12);
    color: #0d5a70;
    font-size: 0.72rem;
    font-weight: 700;
    letter-spacing: 0.04em;
    text-transform: uppercase;
}

.local-card-body {
    display: grid;
    gap: 12px;
}

.local-meta {
    display: grid;
    gap: 4px;
}

.local-meta .label {
    color: #7a8f97;
    font-size: 0.72rem;
    font-weight: 700;
    letter-spacing: 0.08em;
    text-transform: uppercase;
}

.local-meta strong {
    color: #234b59;
    font-size: 0.96rem;
    font-weight: 600;
    line-height: 1.5;
    word-break: break-word;
}

.local-card-actions {
    display: flex;
    flex-wrap: wrap;
    gap: 10px;
    margin-top: auto;
}

.local-card-actions .btn,
.local-card-actions a,
.local-card-actions button {
    white-space: nowrap;
}

.alert {
    margin-bottom: 16px;
}

.local-empty-state {
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    text-align: center;
    min-height: 220px;
    margin-top: 18px;
    padding: 32px 20px;
    border: 1px dashed #c9d8de;
    border-radius: 14px;
    background: linear-gradient(180deg, #ffffff 0%, #f8fbfc 100%);
    color: #5d7380;
}

.local-empty-state i {
    margin-bottom: 12px;
    color: #e4a51b;
    font-size: 2rem;
}

.local-empty-state h4 {
    margin: 0 0 10px;
    color: #183f4d;
    font-size: 1.2rem;
}

.local-empty-state p {
    max-width: 520px;
    margin: 0;
    color: #5d7380;
    font-size: 0.95rem;
    line-height: 1.6;
}

.local-form-section {
    margin-top: 14px;
    padding-top: 16px;
    border-top: 1px solid #edf2f5;
}

.local-form-section:first-of-type {
    margin-top: 0;
    padding-top: 0;
    border-top: none;
}

.local-form-section-title {
    margin: 0 0 12px;
    color: #183f4d;
    font-size: 0.72rem;
    font-weight: 700;
    letter-spacing: 0.12em;
    text-transform: uppercase;
}

.local-edit-header {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 12px;
    width: 100%;
}

.local-edit-badge {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    padding: 6px 10px;
    border-radius: 999px;
    background: rgba(24, 115, 149, 0.1);
    color: #0d5a70;
    font-size: 0.68rem;
    font-weight: 700;
    letter-spacing: 0.08em;
    text-transform: uppercase;
}

.local-map-search-wrap {
    display: flex;
    gap: 10px;
    align-items: center;
}

.local-map-search-btn {
    flex-shrink: 0;
}

.local-map-container {
    width: 100%;
    height: 290px;
    border: 1px solid #dfe7ec;
    border-radius: 12px;
    background: #edf5f8;
    overflow: hidden;
}

.local-map-message {
    min-height: 20px;
    margin-top: 8px;
    color: #436071;
    font-size: 0.8rem;
}

.local-map-message-error {
    color: #b42318;
}

.local-map-message-success {
    color: #0f766e;
}

.leaflet-container {
    width: 100%;
    height: 100%;
    background: #eaf4f7;
}

.modal-content {
    border: 1px solid #e2e8ee;
    border-radius: 16px;
    overflow: hidden;
    box-shadow: 0 20px 45px rgba(15, 45, 56, 0.14);
}

.modal-dialog {
    max-width: min(92vw, 900px);
    margin: 1.5rem auto;
}

.modal-body {
    max-height: min(72vh, 680px);
    overflow-y: auto;
    padding-right: 1rem;
}

.modal-body form {
    width: 100%;
    max-width: 100%;
}

.modal .row {
    --bs-gutter-x: 1rem;
}

.modal .form-control,
.modal .form-select,
.modal textarea {
    width: 100%;
    max-width: 100%;
    min-width: 0;
}

.modal .col-md-6 {
    min-width: 0;
}

.modal-header,
.modal-footer {
    border-color: #edf2f5;
}

.modal-title {
    color: #183f4d;
}

.modal-backdrop {
    background-color: rgba(15, 23, 42, 0.62);
}

@media (max-width: 900px) {
    .dashboard-body,
    .summary-grid,
    .section-grid {
        padding-left: 20px;
        padding-right: 20px;
    }

    .welcome-panel {
        flex-direction: column;
        align-items: flex-start;
    }

    .section-grid {
        grid-template-columns: 1fr;
    }

    .local-card-header,
    .local-edit-header {
        flex-direction: column;
        align-items: flex-start;
    }

    .local-map-search-wrap {
        flex-direction: column;
        align-items: stretch;
    }

    .local-map-search-btn {
        width: 100%;
    }

    .modal-dialog {
        margin: 0.75rem auto;
    }

    .modal-body {
        max-height: 68vh;
        padding-right: 0.75rem;
    }
}
