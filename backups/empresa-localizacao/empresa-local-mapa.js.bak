(function () {
    function triggerMapResize(map) {
        if (!map || typeof map.invalidateSize !== 'function') {
            return;
        }

        setTimeout(function () {
            map.invalidateSize();
        }, 150);

        setTimeout(function () {
            map.invalidateSize();
        }, 400);
    }

    function bindMapToModal(modalElement, mapInstance) {
        if (!modalElement || !mapInstance) {
            return;
        }

        modalElement.addEventListener('shown.bs.modal', function () {
            triggerMapResize(mapInstance);
        });

        modalElement.addEventListener('show.bs.modal', function () {
            triggerMapResize(mapInstance);
        });
    }

    function resolveCityContext(selectElement) {
        if (!selectElement) {
            return null;
        }

        const option = selectElement.options[selectElement.selectedIndex];
        if (!option || !option.value) {
            return null;
        }

        const cidadeNome = option.textContent ? option.textContent.trim() : '';
        const cidadeEstado = option.getAttribute('data-estado') || '';

        if (!cidadeNome && !cidadeEstado) {
            return null;
        }

        return {
            nome: cidadeNome,
            estado: cidadeEstado,
            label: [cidadeNome, cidadeEstado].filter(Boolean).join(', '),
            query: [cidadeNome, cidadeEstado].filter(Boolean).join(', ')
        };
    }

    function getCidadeSelect(isEditMode) {
        return document.getElementById(isEditMode ? 'editar_id_cidade' : 'id_cidade');
    }

    function buildMap(config) {
        const mapElement = document.getElementById(config.mapId);
        const searchInput = document.getElementById(config.searchInputId);
        const searchButton = document.getElementById(config.searchButtonId);
        const messageBlock = document.getElementById(config.messageId);
        const latInput = document.getElementById(config.latInputId);
        const lngInput = document.getElementById(config.lngInputId);
        const addressInput = document.getElementById(config.addressInputId);
        const citySelect = getCidadeSelect(config.isEditMode);

        if (!mapElement || !searchInput || !searchButton || !latInput || !lngInput || !addressInput) {
            return null;
        }

        const map = L.map(mapElement, {
            zoomControl: true,
            scrollWheelZoom: true,
            dragging: true,
            attributionControl: true
        }).setView([-15.7939, -47.8828], 12);

        L.tileLayer('https://{s}.tile.openstreetmap.org/{z}/{x}/{y}.png', {
            attribution: '&copy; OpenStreetMap contributors'
        }).addTo(map);

        let marker = null;

        function updateMessage(text, type) {
            if (!messageBlock) {
                return;
            }

            messageBlock.textContent = text || '';
            messageBlock.classList.remove('local-map-message-error', 'local-map-message-success');
            if (type) {
                messageBlock.classList.add(type === 'error' ? 'local-map-message-error' : 'local-map-message-success');
            }
        }

        function setMarker(lat, lng, fit = false) {
            if (!Number.isFinite(lat) || !Number.isFinite(lng)) {
                return;
            }

            if (!marker) {
                marker = L.marker([lat, lng], { draggable: true }).addTo(map);
                marker.on('dragend', function () {
                    const position = marker.getLatLng();
                    latInput.value = position.lat.toFixed(6);
                    lngInput.value = position.lng.toFixed(6);
                });
            } else {
                marker.setLatLng([lat, lng]);
            }

            latInput.value = lat.toFixed(6);
            lngInput.value = lng.toFixed(6);

            if (fit) {
                map.setView([lat, lng], 16);
            }
        }

        function useCityContext() {
            const currentContext = resolveCityContext(citySelect);

            if (!currentContext) {
                updateMessage('Selecione uma cidade para contextualizar a busca do endereço.', 'error');
                map.setView([-15.7939, -47.8828], 4);
                return false;
            }

            const center = [-15.7939, -47.8828];
            map.setView(center, 12);
            return true;
        }

        function searchAddress() {
            const query = searchInput.value.trim();
            const context = resolveCityContext(citySelect);

            if (!context) {
                updateMessage('Selecione uma cidade antes de buscar o endereço.', 'error');
                return;
            }

            if (!query) {
                updateMessage('Informe um endereço, rua, avenida ou ponto de referência para localizar no mapa.', 'error');
                return;
            }

            const finalQuery = `${query}, ${context.query}`;
            const params = new URLSearchParams({
                q: finalQuery,
                format: 'jsonv2',
                limit: '1',
                addressdetails: '1',
                countrycodes: 'br'
            });

            updateMessage('Buscando localização no mapa...', 'info');

            fetch(`https://nominatim.openstreetmap.org/search?${params.toString()}`, {
                headers: {
                    'Accept-Language': 'pt-BR,pt;q=0.9,en;q=0.8',
                    'User-Agent': 'ArTour/1.0 (contato@artour.local)'
                }
            })
                .then(function (response) {
                    if (!response.ok) {
                        throw new Error('Falha na consulta de endereço.');
                    }
                    return response.json();
                })
                .then(function (results) {
                    if (!Array.isArray(results) || results.length === 0) {
                        updateMessage('Endereço não localizado para a cidade e estado selecionados.', 'error');
                        return;
                    }

                    const result = results[0];
                    const lat = parseFloat(result.lat);
                    const lng = parseFloat(result.lon);

                    if (!Number.isFinite(lat) || !Number.isFinite(lng)) {
                        updateMessage('Coordenadas inválidas retornadas pela busca.', 'error');
                        return;
                    }

                    if (addressInput && result.display_name) {
                        addressInput.value = result.display_name;
                    }

                    setMarker(lat, lng, true);
                    updateMessage('Localização encontrada e ajustada no mapa.', 'success');
                })
                .catch(function () {
                    updateMessage('Não foi possível localizar o endereço informado. Tente outra referência ou ajuste a cidade.', 'error');
                });
        }

        map.on('click', function (event) {
            const lat = event.latlng.lat;
            const lng = event.latlng.lng;
            setMarker(lat, lng, false);
            updateMessage('Marcador posicionado manualmente no mapa.', 'success');
        });

        searchButton.addEventListener('click', searchAddress);
        searchInput.addEventListener('keydown', function (event) {
            if (event.key === 'Enter') {
                event.preventDefault();
                searchAddress();
            }
        });

        if (citySelect) {
            citySelect.addEventListener('change', function () {
                const selectedContext = resolveCityContext(citySelect);
                if (!selectedContext) {
                    updateMessage('Selecione uma cidade antes de procurar no mapa.', 'error');
                    return;
                }

                const fallbackLat = parseFloat(latInput.value || '');
                const fallbackLng = parseFloat(lngInput.value || '');

                if (Number.isFinite(fallbackLat) && Number.isFinite(fallbackLng) && marker) {
                    map.setView([fallbackLat, fallbackLng], 16);
                } else {
                    map.setView([-15.7939, -47.8828], 12);
                }

                updateMessage(`Contexto geográfico atualizado para ${selectedContext.label}.`, 'success');
            });
        }

        const initialLat = parseFloat(latInput.value || '');
        const initialLng = parseFloat(lngInput.value || '');

        if (Number.isFinite(initialLat) && Number.isFinite(initialLng)) {
            setMarker(initialLat, initialLng, true);
        } else {
            const fallbackContext = resolveCityContext(citySelect);
            if (fallbackContext) {
                updateMessage(`Mapa pronto para ${fallbackContext.label}.`, 'success');
            }
            useCityContext();
        }

        triggerMapResize(map);

        return { map, marker, setMarker, searchAddress, updateMessage };
    }

    document.addEventListener('DOMContentLoaded', function () {
        const cadastroMap = buildMap({
            mapId: 'mapaLocalCadastro',
            searchInputId: 'endereco_busca',
            searchButtonId: 'btnBuscarEndereco',
            messageId: 'mapaMensagemCadastro',
            latInputId: 'latitude',
            lngInputId: 'longitude',
            addressInputId: 'endereco',
            isEditMode: false
        });

        const editMap = buildMap({
            mapId: 'mapaLocalEditar',
            searchInputId: 'editar_endereco_busca',
            searchButtonId: 'btnBuscarEnderecoEditar',
            messageId: 'mapaMensagemEditar',
            latInputId: 'editar_latitude',
            lngInputId: 'editar_longitude',
            addressInputId: 'editar_endereco',
            isEditMode: true
        });

        const modalCadastrar = document.getElementById('cadastrarLocalModal');
        const modalEditar = document.getElementById('editarLocalModal');

        if (cadastroMap && cadastroMap.map) {
            bindMapToModal(modalCadastrar, cadastroMap.map);
        }

        if (editMap && editMap.map) {
            bindMapToModal(modalEditar, editMap.map);
        }

        const cidadeCadastro = document.getElementById('id_cidade');
        const cidadeEdicao = document.getElementById('editar_id_cidade');

        [cidadeCadastro, cidadeEdicao].forEach(function (select) {
            if (!select) {
                return;
            }

            const stateSelect = select.getAttribute('data-estado');
            if (stateSelect) {
                const option = select.querySelector('option[value="' + select.value + '"]');
                if (option) {
                    option.setAttribute('data-estado', stateSelect);
                }
            }
        });

        window.artourLocalMap = {
            cadastro: cadastroMap,
            edicao: editMap
        };
    });
})();
